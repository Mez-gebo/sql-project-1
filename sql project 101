 --7. Create the footwear CTE, then calculate the number of products and median revenue from these items.

	 -- SOLUTION --
				
WITH footwear AS ( 
    SELECT info.description,
           finance.revenue
    FROM info
    JOIN finance 
       ON info.product_id = finance.product_id
    WHERE info.description IS NOT NULL
      AND (
           info.description LIKE '%shoe%'
           OR info.description LIKE '%foot%'
           OR info.description LIKE '%trainer%' 
          )
)
SELECT COUNT(*) AS "total_num_of_footgear",
       MEDIAN(revenue) AS "revenue_median"
FROM footwear
WHERE revenue IS NOT NULL;


