 /* 5. Split description into bins in increments of one hundred characters, and calculate 
      average rating for each bin. */

	 -- SOLUTION --

SELECT ((length(info.description) / 100) * 100) || '-' || 
       (((length(info.description) / 100) * 100) + 99) AS "description_length", 
       ROUND(AVG(reviews.rating), 2) AS "avg_rating"
FROM info
JOIN reviews 
   ON info.product_id = reviews.product_id
WHERE info.description IS NOT NULL 
  AND reviews.rating IS NOT NULL
GROUP BY description_length
ORDER BY description_length;


