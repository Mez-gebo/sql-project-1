 --4. Calculate the average discount offered by brand

	 -- SOLUTION --

SELECT brands.brand,
       ROUND(AVG(finance.discount), 2) AS "average_discount"
FROM brands
JOIN finance 
   ON brands.product_id = finance.product_id
WHERE brands.brand IS NOT NULL 
  AND finance.discount IS NOT NULL
GROUP BY brands.brand
ORDER BY average_discount;
   
   
