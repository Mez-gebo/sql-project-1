 -- 3. Create labels  for products grouped by price range and brand.

	 -- SOLUTION --

SELECT brands.brand,
       COUNT(finance.listing_price) AS "count_listingPrice", 
       CASE WHEN finance.listing_price <= 50.00 THEN 'Affordable'
            WHEN finance.listing_price <= 100.00 AND finance.listing_price > 50.00 THEN 'Average'
            WHEN finance.listing_price <= 150.00 AND finance.listing_price > 100.00 THEN 'Expensive'
            ELSE 'Exclusive'
	   END AS "label"
FROM brands
JOIN finance
   ON brands.product_id = finance.product_id
WHERE brands.brand IS NOT NULL
  AND finance.listing_price IS NOT NULL
GROUP BY brands.brand, label
ORDER BY brands.brand, count_listingPrice DESC;
   
   
